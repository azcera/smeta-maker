{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"backend": {
			"root": "backend",
			"framework": "express",
			"installCommand": "npm install",
			"buildCommand": "npm run build"
		},
		"frontend": {
			"root": "frontend",
			"framework": "vite",
			"installCommand": "npm install",
			"buildCommand": "npm run build"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": {
				"service": "backend"
			}
		},
		{
			"source": "/(.*)",
			"destination": {
				"service": "frontend"
			}
		}
	]
}
