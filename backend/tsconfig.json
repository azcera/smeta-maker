{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"ignoreDeprecations": "6.0",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src/**/*"],
	"ts-node": {
		"esm": false
	}
}
