	"type": "commonjs",
	"main": "index.js",
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"build": "tsc && node -e \"const fs=require('fs');const p=require('path');const src='resource/templates';const dst='dist/resource/templates';fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src))fs.copyFileSync(p.join(src,f),p.join(dst,f));\"",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.117.2",
		"cors": "^2.8.6",
		"dotenv": "^18.0.5",
		"exceljs": "^4.4.0",
		"express": "^5.2.1",
		"multer": "^2.4.0",
		"slugify": "^1.6.9",
		"smeta-maker": "file:.."
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.6.3",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "5.4"
	}
}
